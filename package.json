{
  "name": "react-shared-components",
  "version": "1.0.1",
  "description": "React components and hooks with no app knowledge: form fields, layout, Markdown, toasts and canvas effects.",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "LOGO.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview --mode demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,demo}/**/*.{ts,tsx,scss,json,md}\" \"*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"{src,demo}/**/*.{ts,tsx,scss,json,md}\" \"*.{ts,js,json,md}\"",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "gsap": "^3.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "gsap": "^3.15.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "author": "Renato Lins",
  "homepage": "https://github.com/renatolinsdigital/react-shared-components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renatolinsdigital/react-shared-components.git"
  },
  "bugs": {
    "url": "https://github.com/renatolinsdigital/react-shared-components/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
